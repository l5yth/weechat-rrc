# Private key material — never commit; an RRC identity IS the account.
identity
ids/
*.identity
*.key

# A Reticulum config directory created or copied into the checkout. Its
# storage/identities/ holds private keys, and committing one is unrecoverable
# disclosure. rnsd reads ~/.reticulum, not this, so it should not be here at
# all — but if it is, it must never be committed.
.reticulum/

# Documentation stays local until it is decided whether to publish it.
*.md
!README.md

# Agent harness: local tooling, not part of the project.
.claude/

# Test + build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.e2e-hub-hash
.e2e-rrcd/
dist/
build/
*.egg-info/
